{
	"name": "@taskset/contracts",
	"type": "module",
	"private": false,
	"version": "0.1.2",
	"description": "Shared runtime schemas and TypeScript contracts for Taskset.",
	"license": "MIT",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run --root ../.. packages/contracts/src",
		"test:watch": "vitest --root ../.. packages/contracts/src"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"dependencies": {
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@taskset/configs": "workspace:*",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
