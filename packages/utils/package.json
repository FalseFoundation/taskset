{
	"name": "@taskset/utils",
	"type": "module",
	"private": false,
	"version": "0.2.0",
	"description": "Domain-light frontmatter and Markdown utilities for Taskset.",
	"license": "MIT",
	"author": {
		"name": "junkieshuffle",
		"url": "https://github.com/junkieshuffle"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FalseFoundation/taskset.git",
		"directory": "packages/utils"
	},
	"homepage": "https://taskset.false.foundation/",
	"bugs": {
		"url": "https://github.com/FalseFoundation/taskset/issues"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run --root ../.. packages/utils/src",
		"test:watch": "vitest --root ../.. packages/utils/src"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@taskset/configs": "workspace:*",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
