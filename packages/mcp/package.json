{
	"name": "@taskset/mcp",
	"type": "module",
	"private": true,
	"version": "0.1.1",
	"description": "Transport-neutral agent tools and context adapters over Taskset core.",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "pnpm clean && tsc",
		"clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run --root ../.. packages/mcp/src",
		"test:watch": "vitest --root ../.. packages/mcp/src"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"dependencies": {
		"@taskset/core": "workspace:*"
	},
	"devDependencies": {
		"@taskset/configs": "workspace:*",
		"@types/node": "^26.6.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	}
}
