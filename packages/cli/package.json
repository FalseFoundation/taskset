{
	"name": "@taskset/cli",
	"type": "module",
	"private": false,
	"version": "0.2.0",
	"description": "The scriptable command-line interface for Taskset.",
	"license": "MIT",
	"author": {
		"name": "junkieshuffle",
		"url": "https://github.com/junkieshuffle"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/falsefoundation/taskset.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/falsefoundation/taskset#readme",
	"bugs": {
		"url": "https://github.com/falsefoundation/taskset/issues"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"bin": {
		"taskset": "./dist/bin.js"
	},
	"scripts": {
		"build": "pnpm clean && tsc",
		"clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run --root ../.. packages/cli/src",
		"test:watch": "vitest --root ../.. packages/cli/src"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"dependencies": {
		"@taskset/contracts": "workspace:*",
		"@taskset/core": "workspace:*"
	},
	"devDependencies": {
		"@taskset/configs": "workspace:*",
		"@types/node": "^25.9.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
