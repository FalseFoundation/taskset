{
	"name": "@taskset/cli",
	"type": "module",
	"private": false,
	"version": "0.1.1",
	"sideEffects": false,
	"bin": {
		"taskset": "./dist/bin.js"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run --root ../.. packages/cli/src",
		"test:watch": "vitest --root ../.. packages/cli/src"
