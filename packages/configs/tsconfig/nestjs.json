{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "NestJS",
	"extends": "./base.json",
	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"incremental": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"removeComments": true,
		"sourceMap": true
	}
}
