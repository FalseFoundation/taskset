{
	"name": "taskset",
	"description": "Offline, human-readable task management that keeps teams and AI aligned by storing project work alongside the code.",
	"license": "MIT",
	"author": {
		"name": "junkieshuffle",
		"url": "https://github.com/junkieshuffle"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FalseFoundation/taskset.git"
	},
	"homepage": "https://taskset.false.foundation/",
	"bugs": {
		"url": "https://github.com/FalseFoundation/taskset/issues"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test && vitest run tests",
		"test:watch": "turbo test:watch",
		"check": "biome check .",
		"format": "biome format .",
		"lint": "biome lint .",
		"clean": "turbo clean",
		"update-deps": "pnpm up --latest --recursive && pnpm dedupe && pnpm audit --fix update"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@changesets/cli": "^3.0.1",
		"@taskset/cli": "workspace:*",
		"@taskset/configs": "workspace:*",
		"@taskset/core": "workspace:*",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"turbo": "2.10.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=24.16.0",
		"pnpm": ">=11.2.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css,mdx}": [
			"biome check --write --no-errors-on-unmatched",
			"biome format --write --no-errors-on-unmatched"
		]
	}
}
